COMPOSE_PROJECT_NAME=big-data-platform

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_TOPIC=market.candles.v1
KAFKA_ERROR_TOPIC=market.candles.v1.errors

HDFS_DEFAULT_FS=hdfs://namenode:9000
YARN_RESOURCE_MANAGER=resourcemanager
HIVE_METASTORE_URI=thrift://hive-metastore:9083

RAW_PATH=/data/raw/binance/market_candles
RAW_CHECKPOINT_PATH=/checkpoints/raw/binance/market_candles
BRONZE_PATH=/data/bronze/market_candles
BRONZE_CHECKPOINT_PATH=/checkpoints/bronze/market_candles
BRONZE_TRIGGER_INTERVAL=30 seconds
BRONZE_WATERMARK_DELAY=2 days
SILVER_DATABASE=silver
SILVER_TABLE=market_candles

GOLD_DATABASE=gold
GOLD_TABLE=market_indicators

DATAMART_JDBC_URL=jdbc:postgresql://postgres:5432/trading_gold
DATAMART_DB_USER=trading
DATAMART_DB_PASSWORD=trading
DATAMART_INDICATORS_TABLE=market_indicators
DATAMART_LATEST_TABLE=market_indicators_latest
DATAMART_MULTITIMEFRAME_TABLE=market_multitimeframe_signals
DATAMART_DAILY_SUMMARY_TABLE=market_daily_summary
DATAMART_BASE_INTERVAL=1m
DATAMART_CONTEXT_INTERVALS=15m,1h

BINANCE_BASE_URL=https://api.binance.com
PRODUCER_POLL_SECONDS=15

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=airflow@example.local
